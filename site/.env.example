# Copy to .env.local (gitignored) for `npx vercel dev`; on Vercel set these as project environment variables.
# Without a key the command bar still works: /api/command answers 503 and the browser uses its local parser.

# Claude API key for /api/command (server side only; never prefix with VITE_).
ANTHROPIC_API_KEY=

# Optional model override; the default is claude-haiku-4-5 (SPEC.md section 14.6).
# COMMAND_MODEL=claude-sonnet-5
