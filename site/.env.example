# Copy to .env.local (gitignored) for `npx vercel dev`, or run `vercel env pull .env.local`; on Vercel set these as
# project environment variables. All are server side only; never prefix them with VITE_.
# The command function tries Jev, then Claude, skipping an unset key (SPEC.md section 14.3).
# Without either key the command bar still works: /api/command answers 503 and the browser uses its local parser.

# TypeSafe API key for Jev, the first engine.
TYPESAFE_API_KEY=

# Optional Jev version override; the default is pinned to jev-1.13.0, which the confidence thresholds are tuned on.
# JEV_MODEL=jev-latest

# Claude API key, the second engine.
ANTHROPIC_API_KEY=

# Optional Claude model override; the default is claude-haiku-4-5 (SPEC.md section 14.6).
# COMMAND_MODEL=claude-sonnet-5
